# HTTP response headers for the static site (Cloudflare _headers format).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The generated OG image has no file extension; pin its content type so social
# scrapers (Slack, LinkedIn, Facebook, etc.) render it.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
